Box=\"0 0 24 24\" width=\"18\" height=\"18\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\">\n    <path d=\"M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z\"/>\n  </svg>\n);\nconst SaveIcon = ({ saved }) => (\n  <svg viewBox=\"0 0 24 24\" width=\"18\" height=\"18\" fill={saved ? \"#d4c84a\" : \"none\"} stroke={saved ? \"#d4c84a\" : \"currentColor\"} strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\">\n    <path d=\"M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z\"/>\n  </svg>\n);\nconst PlayIcon = () => (\n  <svg viewBox=\"0 0 24 24\" width=\"28\" height=\"28\" fill=\"white\">\n    <polygon points=\"5 3 19 12 5 21 5 3\"/>\n  </svg>\n);\n\nexport default function GroupVideoPost({\n  groupAvatar,\n  groupName,\n  authorName,\n  date,\n  caption,\n  thumbnail,\n  tags = [],\n  likes = 0,\n  shares = 0,\n  comments = 0,\n  onPlay,\n}) {\n  const [liked, setLiked] = useState(false);\n  const [saved, setSaved] = useState(false);\n  const [likeCount, setLikeCount] = useState(likes);\n\n  return (\n    <div className=\"gvp-card\">\n      {/* header */}\n      <div className=\"gvp-header\">\n        <div className=\"gvp-avatar-wrap\">\n          {groupAvatar\n            ? <img src={groupAvatar} alt={groupName} className=\"gvp-avatar\" />\n            : <div className=\"gvp-avatar-placeholder\">{groupName?.charAt(0)}</div>\n          }\n        </div>\n        <div className=\"gvp-header-info\">\n          <span className=\"gvp-group-name\">{groupName}</span>\n          <span className=\"gvp-meta\">{authorName} · {date}</span>\n        </div>\n      </div>\n\n      {caption && <p className=\"gvp-caption\">{caption}</p>}\n\n      {/* video thumb */}\n      <div className=\"gvp-video-wrap\" onClick={onPlay}>\n        {thumbnail && <img src={thumbnail} alt=\"\" className=\"gvp-thumb\" />}\n        <div className=\"gvp-video-overlay\" />\n        <button className=\"gvp-play-btn\"><PlayIcon /></button>\n      </div>\n\n      {tags.length > 0 && (\n        <div className=\"gvp-tags\">\n          {tags.map((t) => <span key={t} className=\"gvp-tag\">#{t}</span>)}\n        </div>\n      )}\n\n      <div className=\"gvp-actions\">\n        <button className={`gvp-action-btn ${liked ? \"gvp-action-btn--liked\" : \"\"}`} onClick={() => { setLiked(v => !v); setLikeCount(v => liked ? v-1 : v+1); }}>\n          <HeartIcon filled={liked} /><span>{likeCount} Likes</span>\n        </button>\n        <button className=\"gvp-action-btn\"><ShareIcon /><span>{shares} Shares</span></button>\n        <button className=\"gvp-action-btn\"><CommentIcon /><span>{comments} Comments</span></button>\n        <button className={`gvp-action-btn ${saved ? \"gvp-action-btn--saved\" : \"\"}`} onClick={() => setSaved(v => !v)}>\n          <SaveIcon saved={saved} /><span>Save</span>\n        </button>\n      </div>\n    </div>\n  );\n}"],"mappings":"AAAA,MAAO,CAAAA,KAAK,EAAIC,QAAQ,KAAQ,OAAO,CACvC,MAAO,sBAAsB,CAAC,OAAAC,GAAA,IAAAC,IAAA,CAAAC,IAAA,IAAAC,KAAA,yBAE9B,KAAM,CAAAC,SAAS,CAAGC,IAAA,MAAC,CAAEC,MAAO,CAAC,CAAAD,IAAA,oBAC3BJ,IAAA,QAAKM,OAAO,CAAC,WAAW,CAACC,KAAK,CAAC,IAAI,CAACC,MAAM,CAAC,IAAI,CAACC,IAAI,CAAEJ,MAAM,CAAG,SAAS,CAAG,MAAO,CAACK,MAAM,CAAEL,MAAM,CAAG,SAAS,CAAG,cAAe,CAACM,WAAW,CAAC,GAAG,CAACC,aAAa,CAAC,OAAO,CAACC,cAAc,CAAC,OAAO,CAAAC,QAAA,cAC1Ld,IAAA,SAAMe,CAAC,CAAC,0IAA0I,CAAC,CAAC,CACjJ,CAAC,EACP,CACD,KAAM,CAAAC,SAAS,CAAGA,CAAA,gBAChBd,KAAA,QAAKI,OAAO,CAAC,WAAW,CAACC,KAAK,CAAC,IAAI,CAACC,MAAM,CAAC,IAAI,CAACC,IAAI,CAAC,MAAM,CAACC,MAAM,CAAC,cAAc,CAACC,WAAW,CAAC,GAAG,CAACC,aAAa,CAAC,OAAO,CAACC,cAAc,CAAC,OAAO,CAAAC,QAAA,eAC5Id,IAAA,aAAUiB,MAAM,CAAC,iBAAiB,CAACC,SAAS,CAAC,gBAAgB,CAAC,CAAC,cAC/DlB,IAAA,SAAMe,CAAC,CAAC,2BAA2B,CAAC,CAAC,EAClC,CACN,CACD,KAAM,CAAAI,WAAW,CAAGA,CAAA,gBAClBnB,IAAA,QAAKM,OAAO,CAAC,WAAW,CAACC,KAAK,CAAC,IAAI,CAACC,MAAM,CAAC,IAAI,CAACC,IAAI,CAAC,MAAM,CAACC,MAAM,CAAC,cAAc,CAACC,WAAW,CAAC,GAAG,CAACC,aAAa,CAAC,OAAO,CAACC,cAAc,CAAC,OAAO,CAAAC,QAAA,cAC5Id,IA